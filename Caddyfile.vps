{
    email {$ACME_EMAIL}
    default_sni {$SITE_ADDRESS}
    key_type rsa2048
    servers {
        protocols h1 h2
    }
    debug
}

{$SITE_ADDRESS}, www.{$SITE_ADDRESS} {
    encode gzip

    tls {
        issuer acme {
            profile shortlived
        }
    }

    reverse_proxy app:8080
}

# Temporary hostname until the production domain is configured.
89-111-152-194.sslip.io {
    encode gzip
    reverse_proxy app:8080
}
