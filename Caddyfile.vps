{
    email {$ACME_EMAIL}
    default_sni {$SITE_ADDRESS}

    servers {
        protocols h1 h2
    }
}

{$SITE_ADDRESS} {
    encode zstd gzip

    tls {
        curves x25519 secp256r1 secp384r1 secp521r1

        issuer acme {
            profile shortlived
        }
    }

    reverse_proxy app:8080
}
